# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/polymarket_weather

# NOAA API Configuration
NOAA_API_KEY=your_noaa_api_key
NOAA_BASE_URL=https://www.ncei.noaa.gov/api/access/

# Additional Weather Sources
ACCUWEATHER_API_KEY=your_accuweather_api_key
AWC_BASE_URL=https://aviationweather.gov/api/data

# Polymarket API Configuration
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_API_SECRET=your_polymarket_api_secret
POLYMARKET_PRIVATE_KEY=your_polymarket_private_key
POLYMARKET_BASE_URL=https://clob.polymarket.com
POLYMARKET_PAPER_TRADING=true

# Kalshi API Configuration. Market DATA is anonymous (capture_prices needs no creds); these are
# for the TRADE endpoints the kalshi_pilot uses. Defaults to the DEMO/paper host; use
# https://api.elections.kalshi.com for production — real money needs BOTH that host AND the
# pilot's --live flag (in CI: the PILOT_LIVE=1 and KALSHI_BASE_URL repository variables plus the
# two secrets). Requests are RSA-PSS signed with your key.
KALSHI_BASE_URL=https://demo-api.elections.kalshi.com
KALSHI_API_KEY_ID=your_kalshi_api_key_id
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem
# ...or inline the PEM instead of a path:
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Model Configuration
MODEL_LOOKBACK_DAYS=365
FORECAST_HORIZON_DAYS=30
PROBABILITY_THRESHOLD=0.5

# Trading Configuration
INITIAL_CAPITAL=100000
MAX_POSITION_SIZE=0.1
MIN_BID_ASK_SPREAD=0.02

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
